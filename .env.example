# URL publica y canonica de la aplicacion (sin barra final).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. La publishable key puede usarse en el navegador; la service role es
# exclusivamente de servidor y nunca debe llevar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=

# Correo transaccional (Resend).
RESEND_API_KEY=

# Protege las rutas /api/cron/* invocadas por Vercel Cron.
CRON_SECRET=

# Upstash Redis / Vercel KV para el rate limiting. En produccion son obligatorias:
# sin ellas las rutas protegidas por el limitador responden con error.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Maps JavaScript API (se expone al navegador; restringir por referrer).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places API, solo servidor (restringir por API y entorno en Google Cloud).
GOOGLE_MAPS_API_KEY=

# Google Geocoding API, solo servidor.
GOOGLE_GEOCODING_API_KEY=

# OAuth 2.0 de Google Calendar, solo servidor.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Credenciales exclusivas para pruebas E2E locales (no usar cuentas reales).
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
